<Window x:Class="WeightMeasurementApp.SerialPortConfigWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeightMeasurementApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="300"
      Title="SerialPortConfigWindow"
       Width="300" Height="450"
       MaxWidth="300" MaxHeight="450">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="COM Port:"/>
            <ComboBox x:Name="cmbComPort_config" Margin="0,5,0,10"/>
            <TextBlock Text="Baud Rate:"/>
            <ComboBox x:Name="cmbBaudRate_config" Margin="0,5,0,10" SelectedItem="1200">
                <ComboBoxItem Content="1200"/>
                <ComboBoxItem Content="2400"/>
                <ComboBoxItem Content="4800"/>
                <ComboBoxItem Content="9600"/>
                <ComboBoxItem Content="19200"/>
                <ComboBoxItem Content="38400"/>
                <ComboBoxItem Content="57600"/>
                <ComboBoxItem Content="115200"/>
            </ComboBox>

            <TextBlock Text="Parity:"/>
            <ComboBox x:Name="cmbParity_config" Margin="0,5,0,10" SelectedItem="None">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Odd"/>
                <ComboBoxItem Content="Even"/>
                <ComboBoxItem Content="Mark"/>
                <ComboBoxItem Content="Space"/>
            </ComboBox>

            <TextBlock Text="Data Bits:"/>
            <ComboBox x:Name="cmbDataBits_config" Margin="0,5,0,10" SelectedItem="8">
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="8"/>
            </ComboBox>

            <TextBlock Text="Stop Bits:"/>
            <ComboBox x:Name="cmbStopBits_config" Margin="0,5,0,10" SelectedItem="One">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="One"/>
                <ComboBoxItem Content="OnePointFive"/>
                <ComboBoxItem Content="Two"/>
            </ComboBox>

            <TextBlock Text="Handshake:"/>
            <ComboBox x:Name="cmbHandshake_config" Margin="0,5,0,10" SelectedItem="None">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="XOnXOff"/>
                <ComboBoxItem Content="RequestToSend"/>
                <ComboBoxItem Content="RequestToSendXOnXOff"/>
            </ComboBox>
            <CheckBox x:Name="chkAutoConnect_config" Content="Connect อัตโนมัติเมื่อเปิดโปรแกรม" />

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>

</Window>
