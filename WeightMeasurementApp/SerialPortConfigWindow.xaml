<Window x:Class="WeightMeasurementApp.SerialPortConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:WeightMeasurementApp"
        mc:Ignorable="d" 
        Title="การตั้งค่าพอร์ตอนุกรมและรูปแบบข้อมูล"
        Width="500" Height="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- พอร์ตอนุกรม -->
                <GroupBox Header="การตั้งค่าพอร์ตอนุกรม" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- คอลัมน์ซ้าย -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="พอร์ต COM:"/>
                            <ComboBox x:Name="cmbComPort_config"/>

                            <TextBlock Text="อัตราการรับส่งข้อมูล:"/>
                            <ComboBox x:Name="cmbBaudRate_config" SelectedItem="9600">
                                <ComboBoxItem Content="1200"/>
                                <ComboBoxItem Content="2400"/>
                                <ComboBoxItem Content="4800"/>
                                <ComboBoxItem Content="9600"/>
                                <ComboBoxItem Content="19200"/>
                                <ComboBoxItem Content="38400"/>
                                <ComboBoxItem Content="57600"/>
                                <ComboBoxItem Content="115200"/>
                            </ComboBox>

                            <TextBlock Text="Parity:"/>
                            <ComboBox x:Name="cmbParity_config" SelectedItem="None">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Odd"/>
                                <ComboBoxItem Content="Even"/>
                                <ComboBoxItem Content="Mark"/>
                                <ComboBoxItem Content="Space"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- คอลัมน์ขวา -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Data Bits:"/>
                            <ComboBox x:Name="cmbDataBits_config" SelectedItem="8">
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                            </ComboBox>

                            <TextBlock Text="Stop Bits:"/>
                            <ComboBox x:Name="cmbStopBits_config" SelectedItem="One">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="One"/>
                                <ComboBoxItem Content="OnePointFive"/>
                                <ComboBoxItem Content="Two"/>
                            </ComboBox>

                            <TextBlock Text="Handshake:"/>
                            <ComboBox x:Name="cmbHandshake_config" SelectedItem="None">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="XOnXOff"/>
                                <ComboBoxItem Content="RequestToSend"/>
                                <ComboBoxItem Content="RequestToSendXOnXOff"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- รูปแบบข้อมูลน้ำหนัก -->
                <GroupBox Header="การตั้งค่ารูปแบบข้อมูลน้ำหนัก">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- คอลัมน์ซ้าย -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="ตำแหน่งเริ่มต้นของน้ำหนัก:"/>
                            <TextBox x:Name="txtWeightStartPos" Text="5"/>

                            <TextBlock Text="ตำแหน่งสิ้นสุดของน้ำหนัก:"/>
                            <TextBox x:Name="txtWeightEndPos" Text="10"/>

                            <TextBlock Text="จำนวนหลักของน้ำหนัก:"/>
                            <TextBox x:Name="txtWeightDigits" Text="5"/>
                        </StackPanel>

                        <!-- คอลัมน์ขวา -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">

                            <TextBlock Text="เวลาหน่วงสำหรับน้ำหนักคงที่ (ms):"/>
                            <TextBox x:Name="txtWeightStableDelay" Text="1500"/>

                            <TextBlock Text="ค่าน้ำหนักสูงสุด:"/>
                            <TextBox x:Name="txtWeightMaxValue" Text="80000"/>
                            <CheckBox x:Name="chkAutoConnect_config" 
Content="เชื่อมต่ออัตโนมัติเมื่อเปิดโปรแกรม" 
Margin="0,15,0,0"/>

                        </StackPanel>
                  
                    </Grid>

                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ปุ่มดำเนินการ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
    
            <Button x:Name="btnSave" Content="บันทึก" Click="BtnSave_Click" Background="#2196F3"/>
            <Button x:Name="btnCancel" Content="ยกเลิก" Click="BtnCancel_Click" Background="#F44336"/>
        </StackPanel>
    </Grid>
</Window>